# Copy to /etc/picar.env on the Raspberry Pi.
# Leave PICAR_USER and PICAR_PASS unset to disable HTTP authentication.
PICAR_USER=
PICAR_PASS=
PICAR_PORT=5000

# Safety and camera tuning
PICAR_SAFE_STOP_CM=15
PICAR_CLIFF_THRESHOLD=200
PICAR_CONTROL_TIMEOUT=1.5
PICAR_JPEG_QUALITY=70
PICAR_TRACKING_HZ=20
PICAR_PERSON_DETECTOR=auto
PICAR_YOLO_MODEL=/home/solufi/models/yolo11n.pt
PICAR_YOLO_DEVICE=cpu
PICAR_YOLO_CONFIDENCE=0.35

# Optional voice / GPT integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
